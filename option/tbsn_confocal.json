{

    "model": "APBSNModel",
    "pd_a": 2,
    "pd_b": 2,
    "R3": false,
    "R3_T": 8,
    "R3_p": 0.16,

    "networks": [{
        "name": "bsn",
        "type": "TBSN",
        "args": {
            "in_ch": 1,
            "out_ch": 1
        }

    }],

    "train_dataset": {
        "type": "ConfocalTrainDataset",
        "args": {
            "pin_memory": true,
            "patch_size": 64
        },
        "batch_size": 8 
    },
    "validation_datasets": [],

    "lr": 3e-4,
    "print_every": 100,
    "save_every": 10000,
    "validate_every": 20000,
    "num_iters": 100000,
    "log_dir": "log",
    "log_file": "log/log.out"
}
