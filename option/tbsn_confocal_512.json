{

    "model": "APBSNModel",
    "pd_a": 2,
    "pd_b": 2,
    "R3": true,
    "R3_T": 4,
    "R3_p": 0.16,

    "networks": [{
        "name": "bsn",
        "type": "TBSN",
        "args": {
            "in_ch": 1,
            "out_ch": 1
        }
    }],

    "train_dataset": {
        "type": "ConfocalTrainDataset",
        "args": {
            "pin_memory": true,
            "patch_size": 512
        },
        "batch_size": 1
    },
    "validation_datasets": [],

    "lr": 3e-4,
    "print_every": 100,
    "save_every": 5000,
    "validate_every": 10000,
    "num_iters": 150000,
    "log_dir": "log",
    "log_file": "log/log.out"
}
